# Token backend config. Copy to .env and fill in, then:  set -a; . ./.env; set +a
# python3 backend/token_server.py

# Meeting SDK app (Marketplace -> Build App -> Meeting SDK) — used to sign the
# SDK JWT the tablet fetches. The secret stays here, never in the app.
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=

# Server-to-Server OAuth app (Marketplace -> Build App -> Server-to-Server
# OAuth) — lets the backend mint the host ZAK so "Start Meeting" works with no
# browser and no redirect URL (the room hosts as this account). Add scope
# "user:read:admin" (for the ZAK). Copy Account ID + Client ID/Secret here.
ZOOM_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=

PORT=8790

# Only needed for the (future) per-user "Sign in with Zoom" flow on an https
# backend — leave blank for the LAN dev setup above.
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://192.168.1.50:8790
