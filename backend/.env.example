# Token backend config. Copy to .env and fill in, then:  set -a; . ./.env; set +a
# python3 backend/token_server.py

# Meeting SDK app (Marketplace -> Build App -> Meeting SDK) — used to sign the
# SDK JWT the tablet fetches. The secret stays here, never in the app.
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=

# OAuth app (Marketplace -> Build App -> General/OAuth) — used so a user can
# "Sign in with Zoom" to host. Set the app's Redirect URL + allow-list to
# <OAUTH_REDIRECT_BASE>/oauth/callback. Scope needed: user:read (for the ZAK).
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=

# This server's LAN URL as the tablet/browser reaches it (Mac IP).
OAUTH_REDIRECT_BASE=http://192.168.1.50:8790
PORT=8790
