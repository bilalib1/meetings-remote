<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app can use an external RTSP source, so a built-in camera must not
         exclude meeting-room tablets/ChromeOS devices from Play distribution. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="Meetings Remote"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <!-- OAuth returns while a Chrome Custom Tab is above this activity.
             singleTop would create a second MainActivity in that case,
             leaving the old instance registered for Zoom callbacks. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:keepScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Sign in with Zoom" returns here: the backend 302s the browser to
                 https://meetingsremote.app/return?sid=… and Android opens the app
                 directly (verified via /.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="meetingsremote.app"
                    android:path="/return" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MeetingActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:keepScreenOn="true" />
        <!-- TestHooksReceiver (exported adb test hooks) is declared only in the
             debug manifest (src/debug/AndroidManifest.xml) — never in release. -->
        <!-- stopWithTask=false so onTaskRemoved fires when the app is swiped
             away mid-meeting; the service then ends the meeting (no orphans). -->
        <service
            android:name=".MeetingWatchService"
            android:exported="false"
            android:stopWithTask="false" />
        <!-- Holds the MediaProjection + AirPlay mirror stream. Android 14+ requires
             a running mediaProjection-type foreground service before projecting. -->
        <service
            android:name=".AirPlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
